# NEVER COMMIT GAME DATA. Only our own source, configs and tooling belong here.

# Discs and anything extracted or converted from them
assets/
baserom/
extracted/
*.iso
*.gcm
*.rvz
*.wia
*.ciso
*.gcz
*.nkit.*
*.dol
*.rel
*.adx
*.afs
*.prs
*.gvm
*.GVM
*.bml

# Disassembly, recompiled output, analysis dumps (derived from the game)
build/
gen/
asm/
analysis/

# Shader and pipeline caches, SD staging, release output
*.dksh
shader_keys.local.txt
out/
cache/

# Local tools and OS cruft
__pycache__/
*.pyc
.vs/
.vscode/
Thumbs.db
.DS_Store

# decomp-toolkit output (generated from the game; config/*/symbols_seed.txt is the hand-written input)
config/*/symbols.txt
config/*/splits.txt

# PC toolchain downloaded by setup\setup_pc.ps1, and its log
toolchain/
setup.log

# PC run output (logs, saves, settings, mods folder)
*.log
saves/
settings.ini
mods/
crash.txt

# ninja state written by configure.py / ninja
build.ninja
.ninja_deps
.ninja_log
